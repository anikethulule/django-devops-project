            "spot_instance_request_id": "",
            "subnet_id": "subnet-0d4a53e0f368d59f4",
            "tags": {
              "Name": "django-devops-jenkins"
            },
            "tags_all": {
              "Name": "django-devops-jenkins"
            },
            "tenancy": "default",
            "timeouts": null,
            "user_data": "#!/bin/bash\nset -e\n\napt update -y\napt install -y openjdk-17-jdk curl wget git unzip docker.io awscli\n\nsystemctl enable docker\nsystemctl start docker\nusermod -aG docker ubuntu\n\n# Add Jenkins repository with error handling\necho \"Adding Jenkins repository...\"\nif curl -fsSL https://pkg.jenkins.io/debian-stable/jenkins.io-2023.key | gpg --dearmor -o /usr/share/keyrings/jenkins-keyring.gpg 2\u003e/dev/null; then\n  echo \"deb [signed-by=/usr/share/keyrings/jenkins-keyring.gpg] https://pkg.jenkins.io/debian-stable binary/\" | tee /etc/apt/sources.list.d/jenkins.list \u003e /dev/null\nelse\n  echo \"GPG key import failed, adding unsigned repository...\"\n  echo \"deb https://pkg.jenkins.io/debian-stable binary/\" | tee /etc/apt/sources.list.d/jenkins.list \u003e /dev/null\n  # Add legacy key method as fallback\n  wget -q -O - https://pkg.jenkins.io/debian-stable/jenkins.io.key | apt-key add - 2\u003e/dev/null || true\nfi\n\napt update -y || true\n\n# Install Jenkins with retries\nfor i in {1..3}; do\n  echo \"Jenkins installation attempt $i...\"\n  if apt install -y jenkins 2\u003e/dev/null; then\n    echo \"Jenkins installed successfully\"\n    break\n  fi\n  if [ $i -lt 3 ]; then\n    echo \"Installation failed, retrying in 5 seconds...\"\n    sleep 5\n  fi\ndone\n\nsystemctl enable jenkins\nsystemctl start jenkins\n\n# Download and install kubectl\necho \"Downloading kubectl stable version...\"\ncurl -fsSL -o /tmp/stable.txt \"https://dl.k8s.io/release/stable.txt\" || exit 1\nKUBECTL_VERSION=$(cat /tmp/stable.txt | tr -d '\\n')\n\nif [ -z \"$KUBECTL_VERSION\" ]; then\n  echo \"Failed to get kubectl version\"\n  exit 1\nfi\n\necho \"Installing kubectl version: $KUBECTL_VERSION\"\ncurl -fsSL -o /tmp/kubectl \"https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl\" || exit 1\n\nif [ ! -f /tmp/kubectl ]; then\n  echo \"Failed to download kubectl\"\n  exit 1\nfi\n\nchmod +x /tmp/kubectl\nmv /tmp/kubectl /usr/local/bin/\n\n# Install trivy\necho \"Installing trivy...\"\ncurl -fsSL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh | sh -s -- -b /usr/local/bin || exit 1\n\necho \"Jenkins setup completed successfully\"",
            "user_data_base64": null,
            "user_data_replace_on_change": false,
            "volume_tags": null,
            "vpc_security_group_ids": [
