pipeline {
    agent any

    environment {
        AWS_REGION = "us-east-1"
        AWS_ACCOUNT_ID = "065209282584"
        ECR_REPO = "django-devops-app"
        IMAGE_TAG = "${BUILD_NUMBER}"
        IMAGE_URI = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}:${IMAGE_TAG}"
        LATEST_IMAGE_URI = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}:latest"
        SKIP_PIPELINE = "false"
    }

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'main', url: 'https://github.com/anikethulule/django-devops-project.git'
            }
        }

        stage('Check Skip CI') {
            steps {
                script {
                    def commitMessage = sh(
                        script: "git log -1 --pretty=%B",
                        returnStdout: true
                    ).trim()

                    echo "Latest commit message: ${commitMessage}"

                    if (commitMessage.contains("[skip ci]")) {
                        env.SKIP_PIPELINE = "true"
                        currentBuild.result = 'SUCCESS'
                        echo "Skipping pipeline because this is Jenkins auto commit."
                    }
                }
            }
        }

        stage('SonarQube Static Code Analysis') {
            when {
                expression { env.SKIP_PIPELINE != "true" }
            }
            steps {
                withSonarQubeEnv('SonarQube') {
                    script {
                        def scannerHome = tool 'SonarScanner'
                        sh """
                        ${scannerHome}/bin/sonar-scanner \
                          -Dsonar.projectKey=django-devops-app \
                          -Dsonar.projectName=django-devops-app \
                          -Dsonar.sources=app \
                          -Dsonar.exclusions=app/venv/**,app/.venv/**,**/__pycache__/**,**/migrations/** \
                          -Dsonar.python.version=3.12
                        """
                    }
                }
            }
        }

        stage('Build Docker Image') {
            when {
                expression { env.SKIP_PIPELINE != "true" }
            }
            steps {
                sh '''
                docker build -t ${ECR_REPO}:${IMAGE_TAG} ./app
                docker tag ${ECR_REPO}:${IMAGE_TAG} ${IMAGE_URI}
                docker tag ${ECR_REPO}:${IMAGE_TAG} ${LATEST_IMAGE_URI}
                '''
            }
        }

        stage('Trivy Security Scan Report') {
            when {
                expression { env.SKIP_PIPELINE != "true" }
            }
            steps {
                sh '''
                mkdir -p trivy-reports

                trivy image \
                  --severity HIGH,CRITICAL \
                  --exit-code 0 \
                  --format table \
                  --output trivy-reports/trivy-image-report.txt \
                  ${ECR_REPO}:${IMAGE_TAG}

                echo "========== Trivy Scan Report =========="
                cat trivy-reports/trivy-image-report.txt
                echo "========== Trivy scan completed. Pipeline will continue. =========="
                '''

                withCredentials([string(credentialsId: 'slack-webhook-url', variable: 'SLACK_WEBHOOK')]) {
                    sh '''
                    curl -X POST -H 'Content-type: application/json' \
                    --data "{
                      \\"text\\": \\" Trivy Security Scan Completed\\nJob: ${JOB_NAME}\\nBuild: #${BUILD_NUMBER}\\nImage: ${ECR_REPO}:${IMAGE_TAG}\\nStatus: Security report generated. Pipeline continued.\\"
                    }" \
                    ${SLACK_WEBHOOK}
                    '''
                }
            }
        }

        stage('Login to ECR') {
            when {
                expression { env.SKIP_PIPELINE != "true" }
            }
            steps {
                withCredentials([
                    string(credentialsId: 'aws-access-key', variable: 'AWS_ACCESS_KEY_ID'),
                    string(credentialsId: 'aws-secret-key', variable: 'AWS_SECRET_ACCESS_KEY')
                ]) {
                    sh '''
                    aws ecr get-login-password --region ${AWS_REGION} | \
                    docker login --username AWS --password-stdin \
                    ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
                    '''
                }
            }
        }

        stage('Push Image to ECR') {
            when {
                expression { env.SKIP_PIPELINE != "true" }
            }
            steps {
                sh '''
                docker push ${IMAGE_URI}
                docker push ${LATEST_IMAGE_URI}
                '''

                withCredentials([string(credentialsId: 'slack-webhook-url', variable: 'SLACK_WEBHOOK')]) {
                    sh '''
                    curl -X POST -H 'Content-type: application/json' \
                    --data "{
                      \\"text\\": \\" Docker Image Pushed to ECR\\nImage URI: ${IMAGE_URI}\\nLatest URI: ${LATEST_IMAGE_URI}\\"
                    }" \
                    ${SLACK_WEBHOOK}
                    '''
                }
            }
        }

        stage('Update Kubernetes Manifest') {
            when {
                expression { env.SKIP_PIPELINE != "true" }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-token',
                    usernameVariable: 'GIT_USERNAME',
                    passwordVariable: 'GIT_TOKEN'
                )]) {
                    sh '''
                    sed -i "s|image: .*|image: ${IMAGE_URI}|g" k8s/deployment.yaml

                    git config user.email "jenkins@example.com"
                    git config user.name "jenkins"

                    git add k8s/deployment.yaml

                    if git diff --cached --quiet; then
                        echo "No manifest changes to commit"
                    else
                        git commit -m "[skip ci] Update image to ${IMAGE_TAG}"
                        git remote set-url origin https://${GIT_USERNAME}:${GIT_TOKEN}@github.com/anikethulule/django-devops-project.git
                        git push origin main
                    fi
                    '''
                }

                withCredentials([string(credentialsId: 'slack-webhook-url', variable: 'SLACK_WEBHOOK')]) {
                    sh '''
                    curl -X POST -H 'Content-type: application/json' \
                    --data "{
                      \\"text\\": \\" Kubernetes Manifest Updated\\nApplication: django-app\\nNew Image: ${IMAGE_URI}\\nStatus: Manifest pushed to GitHub. ArgoCD will sync to EKS.\\"
                    }" \
                    ${SLACK_WEBHOOK}
                    '''
                }
            }
        }
    }

    post {
        success {
            script {
                if (env.SKIP_PIPELINE == "true") {
                    echo "Pipeline skipped successfully because commit contains [skip ci]."
                } else {
                    echo "CI pipeline completed successfully"

                    withCredentials([string(credentialsId: 'slack-webhook-url', variable: 'SLACK_WEBHOOK')]) {
                        sh '''
                        curl -X POST -H 'Content-type: application/json' \
                        --data "{
                          \\"text\\": \\" Django CI/CD Pipeline Successful\\nJob: ${JOB_NAME}\\nBuild: #${BUILD_NUMBER}\\nImage: ${IMAGE_URI}\\nStatus: Build, SonarQube, Trivy report, ECR push and ArgoCD manifest update completed.\\"
                        }" \
                        ${SLACK_WEBHOOK}
                        '''
                    }
                }
            }
        }

        failure {
            script {
                if (env.SKIP_PIPELINE != "true") {
                    echo "CI pipeline failed"

                    withCredentials([string(credentialsId: 'slack-webhook-url', variable: 'SLACK_WEBHOOK')]) {
                        sh '''
                        curl -X POST -H 'Content-type: application/json' \
                        --data "{
                          \\"text\\": \\" Django CI/CD Pipeline Failed\\nJob: ${JOB_NAME}\\nBuild: #${BUILD_NUMBER}\\nPlease check Jenkins console logs.\\"
                        }" \
                        ${SLACK_WEBHOOK}
                        '''
                    }
                } else {
                    echo "Skipped pipeline should not send failure notification."
                }
            }
        }
    }
}
